# Ports
GATEWAY_HTTP_PORT=8080
USER_GRPC_PORT=50051
ORDER_GRPC_PORT=50052
CATALOG_GRPC_PORT=50053
PAYMENT_GRPC_PORT=50054
CATALOG_HTTP_PORT=8001
PAYMENT_HTTP_PORT=8002

# Service-owned DB files for local Phase 2
USER_DB_PATH=user-service.db
ORDER_DB_PATH=order-service.db
CATALOG_DB_PATH=catalog-service.db
PAYMENT_DB_PATH=payment-service.db

# Service names (future compose/k8s use)
USER_SERVICE_HOST=user-service-go
ORDER_SERVICE_HOST=order-service-go
CATALOG_SERVICE_HOST=catalog-service-py
PAYMENT_SERVICE_HOST=payment-service-py

# Direct gRPC addresses for local development
USER_SERVICE_ADDR=localhost:50051
ORDER_SERVICE_ADDR=localhost:50052
CATALOG_SERVICE_ADDR=localhost:50053
PAYMENT_SERVICE_ADDR=localhost:50054
